APP_NAME=Aucvy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Opslag altijd in UTC, weergave in Europe/Amsterdam (config/aucvy.php).
# Anders verschuiven veilingeindtijden bij de zomertijdovergang.
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aucvy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Op https (productie) altijd true: anders reist het sessiecookie ook over http.
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Op de server: cache/queue/locks naar Redis (briefing hfst. 3 — aparte
# databases per doel: 0 cache, 1 queue, 2 locks). Lokaal op Windows draait
# Redis niet standaard en ontbreekt pcntl, dus daar volstaat de database-driver.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Waar het contactformulier, de systeemalarmen en het geld-dat-aandacht-vraagt
# heen mailen. Leeg valt terug op MAIL_FROM_ADDRESS; de systeempagina
# waarschuwt zolang dit een example.com-adres is.
AUCVY_SUPPORT_EMAIL=

# Mailgun (besluit Raph, 2 november 2026). Zet MAIL_MAILER=mailgun zodra het
# account klaar is. De webhooksleutel staat in Mailgun onder Webhooks; de
# webhook-URL is /webhooks/mailgun (events: delivered, failed, complained).
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Aucvy platform ---------------------------------------------------------
# Weergavetijdzone. Opslag blijft UTC.
AUCVY_DISPLAY_TIMEZONE=Europe/Amsterdam

# Biedmotor. Deze waarden zijn de standaard bij het aanmaken van een veiling;
# per veiling worden ze vastgelegd zodat een wijziging hier niet met
# terugwerkende kracht geldt (briefing hfst. 5).
AUCVY_ANTI_SNIPE_WINDOW_SECONDS=30
AUCVY_ANTI_SNIPE_EXTEND_SECONDS=60

# Opgeld koper: blijft 0% in de MVP. Het veld bestaat, de waarde is nul.
AUCVY_BUYER_PREMIUM_PERCENT=0

# Borg vóór bieden boven dit bedrag. Voorstel briefing hfst. 9: € 2.500.
AUCVY_DEPOSIT_THRESHOLD_CENTS=250000

# Identiteits- en bedrijfscontrole: standaard beoordeelt beheer in de
# compliance-queue. true keurt direct goed (alleen lokaal en demo).
AUCVY_VERIFICATION_AUTO_APPROVE=false

# Noodrem voor de complete AI-laag. Staat dit uit, dan blijft alles werken:
# de funnel is handmatig invulbaar, zoeken valt terug op gewone filters.
AUCVY_AI_ENABLED=true
AUCVY_AI_DAILY_BUDGET_CENTS=500
AUCVY_AI_DAILY_BUDGET_TOTAL_CENTS=10000

# AI-provider: `fake` is deterministisch en gratis (lokaal en CI).
# Echt: AUCVY_AI_PROVIDER=anthropic plus een eigen ANTHROPIC_API_KEY.
AUCVY_AI_PROVIDER=fake
AUCVY_AI_MODEL=claude-sonnet-5
# Onder deze zekerheid moet de verkoper een Ivy-veld bevestigen vóór publicatie.
AUCVY_AI_CONFIRMATION_THRESHOLD=0.8
AUCVY_AI_TRANSLATE=true

# Verboden categorieën (slugs, komma-gescheiden). Lijst komt van Raphael.
AUCVY_FORBIDDEN_CATEGORIES=
ANTHROPIC_API_KEY=

# Betaalprovider: `fake` geeft een nepcheckout onder /dev/checkout.
# Echt: AUCVY_PAYMENT_PROVIDER=mollie plus MOLLIE_API_KEY=test_...
# (de webhook vereist een publieke URL, dus dat werkt pas op staging).
AUCVY_PAYMENT_PROVIDER=fake
MOLLIE_API_KEY=

# Transportindicaties: `fake` rekent deterministisch zonder partner.
AUCVY_SHIPPING_PROVIDER=fake

# De home: variant b (preview v4) is gekozen en staat voor iedereen aan.
# Zet de A/B-test aan voor een 50/50-verdeling met het oude ontwerp (a).
# ?variant=a, ?variant=b en /ab-test werken altijd.
AUCVY_HOME_VARIANT=c
AUCVY_HOME_EXPERIMENT_ENABLED=false

# Web push (hfst. 14): "je bent overboden" binnen twee seconden op het
# scherm. Genereer een sleutelpaar met `php artisan webpush:vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Reverb (websockets) ----------------------------------------------------
# Eigen proces, eigen poort. Zelf hosten is een bewuste keuze: het slotmoment
# van een veiling is precies het moment waarop je geen externe rate limit wilt
# raken (briefing hfst. 2). Pusher werkt met dezelfde clientcode, dus
# omschakelen is alleen deze blok vervangen.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
